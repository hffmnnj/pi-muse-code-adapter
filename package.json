{
  "name": "pi-muse-code-adapter",
  "version": "1.0.0",
  "description": "Muse Code subscription models for Pi and Pi Durable, with native streaming and host-owned tools",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-durable",
    "muse-code",
    "meta",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hffmnnj/pi-muse-code-adapter.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./provider": "./dist/provider.js"
  },
  "files": [
    "src",
    "dist",
    "examples",
    "scripts/prepare.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx scripts/smoke-live.ts",
    "test:cli": "tsx scripts/smoke-cli.ts",
    "format:check": "prettier --check src test scripts examples README.md package.json tsconfig.json",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@types/node": "^22.19.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2",
    "@earendil-works/pi-durable": ">=1.3.0 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
